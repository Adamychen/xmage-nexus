{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mage": {
      "type": "local",
      "command": ["node", "mcp/src/index.ts"],
      "cwd": ".",
      "enabled": true,
      "timeout": 1800000
    },
    "playwright": {
      "type": "local",
      "command": ["node", "scripts/playwright-mcp.mjs", "--headless", "--viewport-size", "1600x900", "--timeout-action", "15000"],
      "cwd": ".",
      "enabled": true,
      "timeout": 120000
    }
  }
}
