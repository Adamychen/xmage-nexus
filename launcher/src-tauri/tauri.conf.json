{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XMage Nexus",
  "version": "0.1.0",
  "identifier": "today.xmage.nexus",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "XMage Nexus",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      },
      {
        "label": "splash",
        "title": "XMage Nexus",
        "url": "splash.html",
        "width": 420,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: https://*.scryfall.io data: blob:; connect-src 'self' ipc: http://ipc.localhost ws: wss: https://api.scryfall.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline'"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Adamychen/xmage-nexus/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCNkQ0OUYwRjA1NDc4QgpSV1NMUndVUG45UzJESFUwZUVFUzRrUytsZGRMdlY1VzR3aDhUV0FjRnU1UWh2UlZIK1Flcms2Zwo="
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "CardGame",
    "shortDescription": "Modern XMage client with bundled server",
    "longDescription": "XMage Nexus: modern web client plus one-click local XMage server and proxy. Play offline or on beta.xmage.today."
  }
}
